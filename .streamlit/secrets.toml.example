SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY = "xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Chave "service_role" do Supabase (Settings -> API -> Project API keys).
# PODER TOTAL: ignora todo RLS. Usada só no servidor, só para a usuária
# excluir a própria conta (auth.admin.delete_user). Nunca commitar o valor
# real, nunca colar em código, nunca expor no navegador — só nos Secrets
# do Streamlit Cloud e no secrets.toml local (já no .gitignore). Sem essa
# chave, o botão "Excluir minha conta e meus dados" mostra um aviso em vez
# de excluir.
SUPABASE_SERVICE_ROLE_KEY = "xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# URL pública da página Pausas e Palavras, usada como retorno do login com Google.
# Sem essa chave o botão "Entrar com Google" não aparece (cai só no e-mail/senha).
APP_URL = "https://seu-app.streamlit.app/Pausas_e_Palavras"
# Chave da API da Anthropic (console.anthropic.com), usada para gerar o
# relatório psicológico semanal. Sem essa chave a seção "Relatório da
# semana" mostra um aviso em vez do botão.
ANTHROPIC_API_KEY = "sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
